# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/hireflow

# Auth
JWT_SECRET=replace-with-a-long-random-secret-min-32-chars

# Frontend URL (used for CORS and password reset links)
CLIENT_URL=http://localhost:5173

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Sign up free at https://resend.com
# Dashboard → API Keys → Create API Key → copy it here
#
# For RESEND_FROM — until you verify a domain, use: onboarding@resend.dev
# After adding your domain in Resend dashboard you can use: HireFlow <you@yourdomain.com>
#
# Leave RESEND_API_KEY empty in dev to just log emails to the console.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=HireFlow <onboarding@resend.dev>
